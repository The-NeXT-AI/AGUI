{
  "name": "agui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.1"
  },
  "main": "dist-electron/main.js",
  "description": "AGUI Desktop — an Electron coding agent client powered by Agent Server Protocol (ASP).",
  "author": "AGUI contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-NeXT-AI/AGUI.git"
  },
  "homepage": "https://github.com/The-NeXT-AI/AGUI#readme",
  "bugs": {
    "url": "https://github.com/The-NeXT-AI/AGUI/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:pure-web": "node scripts/dev-pure-web.mjs",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "build": "pnpm build:frontend",
    "build:github-extension": "pnpm --dir extensions/github build",
    "build:mail-extension": "pnpm --dir extensions/mail build",
    "build:frontend": "tsc -b && vite build",
    "build:electron": "tsc -b tsconfig.electron.json",
    "build:server": "pnpm --filter @the-next-ai/agui-server build",
    "build:app": "pnpm build:frontend && pnpm build:electron",
    "pack:frontend": "pnpm build:frontend && node scripts/package-frontend.mjs",
    "pack:server": "pnpm build:frontend && pnpm build:server && node scripts/package-server.mjs",
    "pack:electron": "pnpm build:app && node scripts/package-electron.mjs --publish never --config.directories.output=release/electron",
    "pack:electron:dir": "pnpm build:app && node scripts/package-electron.mjs --dir --publish never --config.directories.output=release/electron-dir",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bench:markdown": "node scripts/markdown-render-benchmark.mjs",
    "server": "pnpm build && node packages/server/dist/index.js",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs && node scripts/ensure-electron-binary.mjs",
    "typecheck": "pnpm --filter @the-next-ai/agui-extensions typecheck && pnpm --filter @the-next-ai/asp typecheck && pnpm --filter @the-next-ai/agui-runtime typecheck && pnpm --filter @the-next-ai/agui-app typecheck && pnpm --filter @the-next-ai/agui-server typecheck && tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:asp": "pnpm build:electron && node scripts/asp-smoke.mjs",
    "schema:asp": "pnpm --filter @the-next-ai/asp build && node scripts/generate-asp-schema.mjs",
    "security:audit": "pnpm audit --audit-level moderate",
    "test:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:asp && pnpm docs:build && pnpm security:audit",
    "test:multi-agent": "node --experimental-strip-types scripts/multi-agent-session-tests.mjs",
    "test:scheduled": "node --experimental-strip-types scripts/scheduled-task-reliability-tests.mjs",
    "test:unit": "pnpm test:scheduled && pnpm test:multi-agent",
    "test:e2e": "pnpm build:app && node scripts/e2e-electron.mjs",
    "test:server-package": "pnpm pack:server && node scripts/server-package-smoke.mjs",
    "test:extension-contracts": "pnpm build:app && pnpm build:server && pnpm build:github-extension && node --experimental-strip-types scripts/mcp-app-state-tests.mjs && node scripts/extension-contract-tests.mjs && node scripts/github-mcp-server-tests.mjs",
    "test:extensions": "pnpm build:app && pnpm build:server && pnpm build:github-extension && node --experimental-strip-types scripts/mcp-app-state-tests.mjs && node scripts/extension-contract-tests.mjs && node scripts/github-mcp-server-tests.mjs && node scripts/e2e-electron.mjs",
    "extension:create": "node scripts/create-extension-from-template.mjs",
    "extension:pack": "node scripts/package-extension.mjs",
    "dist": "pnpm pack:electron"
  },
  "dependencies": {
    "@the-next-ai/asp": "workspace:*",
    "@the-next-ai/agui-extensions": "workspace:*",
    "@the-next-ai/agui-runtime": "workspace:*"
  },
  "devDependencies": {
    "@the-next-ai/agui-app": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@musistudio/lucide-morph-react": "^1.0.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "highlight.js": "11.12.0",
    "i18next": "^26.5.6",
    "katex": "^0.19.0",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.57.0",
    "nanoid": "^5.0.9",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.72.0",
    "unified": "11.0.5",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.16",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "sqlite3",
      "tree-sitter",
      "tree-sitter-javascript",
      "tree-sitter-typescript"
    ],
    "overrides": {
      "dompurify": "3.4.14",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "postcss": "8.5.26"
    }
  }
}
