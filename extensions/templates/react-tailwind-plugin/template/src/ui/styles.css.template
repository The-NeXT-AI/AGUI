@import "tailwindcss";

@source "./**/*.{ts,tsx}";

:root {
  color-scheme: dark;
}

html,
body,
#root {
  min-width: 0;
}

body {
  margin: 0;
  background: transparent;
  color: var(--agui-fg);
  font-family:
    ui-sans-serif,
    system-ui,
    -apple-system,
    sans-serif;
  font-size: 12px;
}

* {
  box-sizing: border-box;
}

html[data-surface="__PLUGIN_NAME__-panel"],
body[data-surface="__PLUGIN_NAME__-panel"],
body[data-surface="__PLUGIN_NAME__-panel"] #root {
  height: 100%;
}

body[data-surface="__PLUGIN_NAME__-panel"] {
  overflow: hidden;
  background: color-mix(in srgb, var(--agui-canvas) 94%, transparent);
}
