import "./styles.css";

import { CircleDot } from "lucide-react";
import { recordValue, stringValue, useAguiData } from "./common";
import { mount } from "./mount";

function ItemRenderer() {
  const data = useAguiData();
  const metadata = recordValue(recordValue(data).metadata);
  const title = stringValue(metadata.title) || stringValue(recordValue(data).text) || "__DISPLAY_NAME__";
  const status = stringValue(metadata.status) || "sample";
  const number = Number(metadata.number || 0);

  return (
    <article className="text-[var(--agui-fg)]">
      <h3 className="mb-3 flex items-center gap-2 text-xl font-bold tracking-[0]">
        <CircleDot className="size-5 shrink-0 text-[var(--agui-accent)]" aria-hidden="true" />
        <span className="min-w-0 [overflow-wrap:anywhere]">{title}</span>
      </h3>
      <div className="flex flex-wrap gap-2">
        <span className="rounded-full border border-[var(--agui-border)] bg-[color-mix(in_srgb,var(--agui-surface)_86%,transparent)] px-2.5 py-1 text-[var(--agui-muted)]">
          {status}
        </span>
        {number > 0 ? (
          <span className="rounded-full border border-[var(--agui-border)] bg-[color-mix(in_srgb,var(--agui-surface)_86%,transparent)] px-2.5 py-1 text-[var(--agui-muted)]">
            #{number}
          </span>
        ) : null}
      </div>
    </article>
  );
}

mount(<ItemRenderer />);
