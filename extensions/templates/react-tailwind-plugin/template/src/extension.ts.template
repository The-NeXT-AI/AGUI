const NAMESPACE = "__NAMESPACE__";
const DISPLAY_NAME = "__DISPLAY_NAME__";
const ENABLED_KEY = `${NAMESPACE}.enabled`;
const ITEM_RENDERER = `${NAMESPACE}.item`;

type ExtensionContext = {
  commands: {
    registerCommand(id: string, handler: (input?: unknown) => unknown | Promise<unknown>): void;
  };
  configuration: {
    get(key: string): unknown;
  };
  log?: {
    info(...args: unknown[]): void;
  };
};

export function activate(context: ExtensionContext) {
  context.commands.registerCommand(`${NAMESPACE}.hello`, async (input = {}) => {
    context.log?.info(`${DISPLAY_NAME} hello`, input);
    return {
      message: `Hello from ${DISPLAY_NAME}`,
      received: input,
      timestamp: new Date().toISOString(),
    };
  });

  context.commands.registerCommand(`${NAMESPACE}.panelData`, async () => ({
    generatedAt: new Date().toISOString(),
    items: [
      {
        description: "Backend command result rendered by a sandboxed React webview.",
        label: "Panel data",
      },
      {
        description: "Edit src/extension.ts and src/ui/panel.tsx for your domain.",
        label: "Next step",
      },
    ],
    title: `${DISPLAY_NAME} Panel`,
  }));

  context.commands.registerCommand(`${NAMESPACE}.sessionTree`, async () => {
    if (context.configuration.get(ENABLED_KEY) === false) return { children: [] };
    return {
      children: [
        {
          id: `${NAMESPACE}.samples`,
          title: "Samples",
          kind: "folder",
          children: [sampleSession(1), sampleSession(2)],
        },
      ],
    };
  });
}

function sampleSession(number: number) {
  return {
    id: `${NAMESPACE}.sample.${number}`,
    title: `Sample item #${number}`,
    kind: "session",
    badge: "sample",
    session: {
      title: `${DISPLAY_NAME} sample #${number}`,
      renderer: ITEM_RENDERER,
      initialMarkdown: `### ${DISPLAY_NAME} sample #${number}\n\nThis session was generated by the template backend.`,
      developerInstructions: `This conversation is scoped to ${DISPLAY_NAME} sample #${number}.`,
      metadata: {
        provider: "__PLUGIN_NAME__",
        kind: "sample",
        number,
        status: "open",
        title: `Sample item #${number}`,
      },
    },
  };
}
